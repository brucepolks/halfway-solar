{% extends "base.html" %}
{% block title %}Settings — Halfway Charge{% endblock %}
{% block content %}
<h1 class="page-title">Settings</h1>
<p class="page-sub">Configure Dash IOT credentials and email sending</p>

<div class="card" style="max-width:800px;margin-bottom:24px;border-color:rgba(232,160,32,0.3);background:rgba(232,160,32,0.05);">
  <p style="color:#E8A020;font-size:0.875rem;line-height:1.7;">
    <strong>Railway tip:</strong> Credentials entered here are lost on redeploy. For permanent storage, set them as environment variables in your Railway project → <strong>Variables</strong> tab:<br>
    <code style="background:rgba(0,0,0,0.3);padding:2px 6px;border-radius:4px;">DASH_USERNAME</code>
    <code style="background:rgba(0,0,0,0.3);padding:2px 6px;border-radius:4px;">DASH_PASSWORD</code>
    <code style="background:rgba(0,0,0,0.3);padding:2px 6px;border-radius:4px;">SMTP_HOST</code>
    <code style="background:rgba(0,0,0,0.3);padding:2px 6px;border-radius:4px;">SMTP_PORT</code>
    <code style="background:rgba(0,0,0,0.3);padding:2px 6px;border-radius:4px;">SMTP_USER</code>
    <code style="background:rgba(0,0,0,0.3);padding:2px 6px;border-radius:4px;">SMTP_PASSWORD</code>
  </p>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;max-width:800px;">
  <div class="card">
    <h3 style="font-family:var(--font-d);color:#fff;margin-bottom:20px;">Dash IOT</h3>
    {% if settings.dash_username %}
    <div class="flash" style="margin-bottom:16px;">✓ Credentials active ({{ settings.dash_username }})</div>
    {% endif %}
    <form method="POST">
      <div class="form-group">
        <label>Username / Email</label>
        <input type="text" name="dash_username" value="{{ settings.dash_username or '' }}" placeholder="your@email.com">
      </div>
      <div class="form-group">
        <label>Password</label>
        <input type="password" name="dash_password" placeholder="Leave blank to keep current">
      </div>
      <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center;">Save</button>
    </form>
  </div>

  <div class="card">
    <h3 style="font-family:var(--font-d);color:#fff;margin-bottom:20px;">Email (SMTP)</h3>
    <form method="POST">
      <div class="form-group">
        <label>SMTP Host</label>
        <input type="text" name="smtp_host" value="{{ settings.smtp_host or '' }}" placeholder="smtp.mail.me.com">
      </div>
      <div class="form-group">
        <label>SMTP Port</label>
        <input type="text" name="smtp_port" value="{{ settings.smtp_port or '587' }}">
      </div>
      <div class="form-group">
        <label>Email Address</label>
        <input type="text" name="smtp_user" value="{{ settings.smtp_user or '' }}" placeholder="you@icloud.com">
      </div>
      <div class="form-group">
        <label>App Password</label>
        <input type="password" name="smtp_password" placeholder="Leave blank to keep current">
      </div>
      <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center;">Save</button>
    </form>
  </div>
</div>

<div class="card" style="max-width:800px;margin-top:24px;">
  <h3 style="font-family:var(--font-d);color:#fff;margin-bottom:12px;">iCloud Mail Setup</h3>
  <p style="color:rgba(232,228,223,0.5);font-size:0.875rem;line-height:1.7;">
    Host = <code style="color:#E8A020;">smtp.mail.me.com</code> &nbsp; Port = <code style="color:#E8A020;">587</code><br>
    You need an <strong>App-Specific Password</strong> — generate one at appleid.apple.com → Sign-In &amp; Security → App-Specific Passwords.
  </p>
</div>
{% endblock %}
